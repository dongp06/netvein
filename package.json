{
  "name": "netvein-mcp",
  "version": "0.6.0",
  "description": "Local-first Chrome CDP reverse engineering & wire-level traffic MCP server, for Claude Code, Cursor, Codex, OpenCode, Gemini, AntiGravity, and Hermes Agent — zero DOM bloat, stealth bot bypass, 100% local",
  "type": "module",
  "bin": {
    "netvein": "dist/index.js",
    "netvein-mcp": "dist/index.js",
    "reverse-engineering-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "python",
    "skills",
    "install.sh",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs'); fs.mkdirSync('dist/shims', {recursive:true}); fs.copyFileSync('src/shims/node-proxy.mjs', 'dist/shims/node-proxy.mjs');\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/index.test.ts test/capture.test.ts test/mitm.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "reverse-engineering",
    "chrome-devtools-protocol",
    "cdp",
    "ast",
    "crypto",
    "anti-debug",
    "jsrpc",
    "stealth",
    "frida",
    "signing"
  ],
  "license": "MIT",
  "author": "dongp06 (https://github.com/dongp06)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongp06/netvein.git"
  },
  "homepage": "https://dongp06.github.io/netvein",
  "bugs": {
    "url": "https://github.com/dongp06/netvein/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "chrome-remote-interface": "^0.34.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
