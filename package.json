{
  "name": "reverse-engineering-mcp",
  "version": "0.2.0",
  "description": "An advanced Chrome CDP MCP server for web reverse engineering, dynamic analysis, and runtime instrumentation.",
  "type": "module",
  "bin": {
    "reverse-engineering-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/index.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "reverse-engineering",
    "chrome-devtools-protocol",
    "cdp",
    "ast",
    "crypto",
    "anti-debug",
    "jsrpc"
  ],
  "license": "MIT",
  "author": "dongp06",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "chrome-remote-interface": "^0.34.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
